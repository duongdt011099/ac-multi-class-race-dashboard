@typeparam TColumn

<th class="@CssClass">
    <button type="button" class="wec-table__sort" @onclick="() => OnSort.InvokeAsync(Column)">
        @ChildContent
        <i class="bi @(IsActive && Descending ? "bi-arrow-down-short" : "bi-arrow-up-short") wec-table__sort-icon @(IsActive ? "" : "wec-table__sort-icon--inactive")"></i>
    </button>
</th>

@code {
    [Parameter, EditorRequired] public TColumn Column { get; set; } = default!;

    [Parameter] public TColumn? Current { get; set; }

    [Parameter] public bool Descending { get; set; }

    [Parameter] public EventCallback<TColumn> OnSort { get; set; }

    [Parameter] public string? CssClass { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool IsActive => EqualityComparer<TColumn>.Default.Equals(Column, Current!);
}
