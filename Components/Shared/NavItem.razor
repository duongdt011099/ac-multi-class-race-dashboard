<div class="nav-item px-3">
    @if (Enabled)
    {
        <NavLink class="nav-link" href="@Href" Match="Match">
            <span class="bi @Icon" aria-hidden="true"></span> @Text
        </NavLink>
    }
    else
    {
        <span class="nav-link wec-nav-disabled" aria-disabled="true">
            <span class="bi @Icon" aria-hidden="true"></span> @Text
        </span>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Href { get; set; } = string.Empty;

    /// <summary>Icon class from the nav menu icon set, e.g. bi-car-nav-menu.</summary>
    [Parameter, EditorRequired] public string Icon { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string Text { get; set; } = string.Empty;

    /// <summary>When false the entry is shown greyed out and cannot be followed.</summary>
    [Parameter] public bool Enabled { get; set; } = true;

    [Parameter] public NavLinkMatch Match { get; set; } = NavLinkMatch.Prefix;
}
