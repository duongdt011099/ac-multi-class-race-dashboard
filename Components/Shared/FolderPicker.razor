@inject ToastService Toast

@if (ShowBrowseButton)
{
    <div class="wec-form-field">
        <label for="@($"{InputId}-value")">@FieldLabel</label>
        <div class="wec-folder-picker__row">
            <input id="@($"{InputId}-value")" type="text" value="@ValueDisplay" readonly
                   placeholder="Not set" />
            <button type="button" class="wec-toolbar__btn" @onclick="() => Open()">
                <i class="bi bi-folder2-open"></i> Browse...
            </button>
        </div>
    </div>
}

@if (isOpen)
{
    <div class="wec-modal-overlay">
        <div class="wec-modal">
            <div class="wec-modal__header">
                <span>@Title</span>
                <button type="button" class="wec-modal__close" aria-label="Close" @onclick="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="wec-modal__body">
                <div class="wec-folder-picker__current">@CurrentPathLabel</div>

                <div class="wec-folder-picker__list">
                    @if (isLoading)
                    {
                        <div class="wec-empty">Loading...</div>
                    }
                    else if (!entries.Any())
                    {
                        <div class="wec-empty">Nothing here.</div>
                    }
                    else
                    {
                        @foreach (var entry in entries)
                        {
                            <button type="button"
                                    class="wec-folder-picker__row @(IncludeFiles && entry.IsFile && selectedPath == entry.FullPath ? "wec-folder-picker__row--selected" : null)"
                                    @onclick="() => OnEntryClick(entry)">
                                <i class="bi @(entry.IsDrive ? "bi-hdd" : entry.IsFile ? "bi-file-earmark-text" : "bi-folder-fill")" aria-hidden="true"></i>
                                <span class="wec-folder-picker__row-name">@entry.Name</span>
                            </button>
                        }
                    }
                </div>
            </div>
            <div class="wec-modal__footer">
                <button type="button" class="wec-modal__btn wec-modal__btn--secondary" @onclick="GoUp">Up</button>
                <button type="button" class="wec-modal__btn wec-modal__btn--secondary" @onclick="GoHome">My Computer</button>
                <span class="wec-folder-picker__spacer"></span>
                <button type="button" class="wec-modal__btn wec-modal__btn--secondary" @onclick="Close">Cancel</button>
                <button type="button" class="wec-modal__btn wec-modal__btn--primary" disabled="@(!CanSelect)"
                        title="@(IncludeFiles ? "Select the highlighted file" : "Select this folder")"
                        @onclick="SelectCurrent">
                    @(IncludeFiles ? "Select this file" : "Select this folder")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private sealed class FolderEntry
    {
        public required string Name { get; set; }
        public required string FullPath { get; set; }
        public bool IsDrive { get; set; }
        public bool IsFile { get; set; }
    }

    [Parameter, EditorRequired]
    public string FieldLabel { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public string? InputId { get; set; }

    [Parameter]
    public bool IncludeFiles { get; set; }

    [Parameter]
    public string FilePattern { get; set; } = "*.cmpreset";

    [Parameter]
    public bool ShowBrowseButton { get; set; } = true;

    [Parameter]
    public string? RootPath { get; set; }

    private bool isOpen;
    private bool isLoading;
    private string currentPath = string.Empty;
    private string? selectedPath;
    private List<FolderEntry> entries = new();

    private string ValueDisplay => string.IsNullOrWhiteSpace(Value) ? "" : Value;

    private string CurrentPathLabel => currentPath == string.Empty
        ? "My Computer"
        : currentPath;

    private bool CanSelect => IncludeFiles
        ? selectedPath is not null
        : currentPath != string.Empty;

    public void Open(string? startPath = null)
    {
        isOpen = true;

        var resolved = string.IsNullOrWhiteSpace(startPath) ? Value : startPath;
        var path = string.IsNullOrWhiteSpace(resolved) ? string.Empty : resolved.Trim();

        if (path != string.Empty && !Directory.Exists(path))
        {
            path = string.Empty;
        }

        currentPath = path;
        selectedPath = null;
        _ = LoadEntriesAsync();
    }

    private void Close()
    {
        isOpen = false;
    }

    private async Task OnEntryClick(FolderEntry entry)
    {
        if (IncludeFiles && entry.IsFile)
        {
            selectedPath = entry.FullPath;
            await InvokeAsync(StateHasChanged);
            return;
        }

        await Navigate(entry);
    }

    private async Task Navigate(FolderEntry entry)
    {
        currentPath = Path.GetFullPath(entry.FullPath);
        selectedPath = null;
        await LoadEntriesAsync();
    }

    private async Task GoUp()
    {
        if (currentPath == string.Empty)
        {
            return;
        }

        var parent = Directory.GetParent(currentPath);

        if (parent is null)
        {
            currentPath = string.Empty;
        }
        else if (RootPath is not null && !IsInsideRoot(parent.FullName))
        {
            currentPath = RootPath;
        }
        else
        {
            currentPath = parent.FullName;
        }

        selectedPath = null;
        await LoadEntriesAsync();
    }

    private async Task GoHome()
    {
        currentPath = string.Empty;
        selectedPath = null;
        await LoadEntriesAsync();
    }

    private async Task LoadEntriesAsync()
    {
        isLoading = true;
        entries = new List<FolderEntry>();

        try
        {
            if (currentPath == string.Empty)
            {
                entries = DriveInfo.GetDrives()
                    .Where(d => d.IsReady && d.DriveType is DriveType.Fixed or DriveType.Network)
                    .Select(d => new FolderEntry
                    {
                        Name = d.Name,
                        FullPath = d.Name,
                        IsDrive = true
                    })
                    .OrderBy(f => f.Name)
                    .ToList();
            }
            else
            {
                entries = Directory.GetDirectories(currentPath)
                    .Select(full => new FolderEntry
                    {
                        Name = Path.GetFileName(full),
                        FullPath = full,
                        IsDrive = false
                    })
                    .OrderBy(f => f.Name, StringComparer.OrdinalIgnoreCase)
                    .ToList();

                if (IncludeFiles)
                {
                    entries.AddRange(Directory.GetFiles(currentPath, FilePattern)
                        .Select(full => new FolderEntry
                        {
                            Name = Path.GetFileName(full),
                            FullPath = full,
                            IsFile = true
                        })
                        .OrderBy(f => f.Name, StringComparer.OrdinalIgnoreCase));
                }
            }
        }
        catch (Exception ex)
        {
            Toast.Show($"Could not read folder: {ex.Message}", isError: true);
        }
        finally
        {
            isLoading = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task SelectCurrent()
    {
        if (!CanSelect)
        {
            Toast.Show(IncludeFiles
                ? "Select a file first."
                : "No folder selected.", isError: true);
            return;
        }

        var selected = IncludeFiles
            ? selectedPath
            : currentPath != string.Empty
                ? currentPath
                : entries.FirstOrDefault(e => e.IsDrive)?.FullPath ?? string.Empty;

        if (string.IsNullOrEmpty(selected))
        {
            Toast.Show(IncludeFiles
                ? "Select a file first."
                : "No folder selected.", isError: true);
            return;
        }

        await ValueChanged.InvokeAsync(selected);
        Close();
    }

    private bool IsInsideRoot(string path)
    {
        var rootFull = Path.GetFullPath(
            RootPath!.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar) +
            Path.DirectorySeparatorChar);

        var full = Path.GetFullPath(path);

        return full.Equals(rootFull, StringComparison.OrdinalIgnoreCase) ||
               full.StartsWith(rootFull, StringComparison.OrdinalIgnoreCase);
    }
}