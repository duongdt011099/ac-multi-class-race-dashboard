<button type="button" class="wec-modal__btn wec-modal__btn--secondary" @onclick="OnCancel">@CancelText</button>
<button type="button" class="wec-modal__btn @(Danger ? "wec-modal__btn--danger" : "wec-modal__btn--primary")"
        @onclick="OnConfirm" disabled="@(IsBusy || Disabled)">
    @(IsBusy ? BusyText : ConfirmText)
</button>

@code {
    [Parameter] public string CancelText { get; set; } = "Cancel";

    [Parameter, EditorRequired] public string ConfirmText { get; set; } = string.Empty;

    [Parameter] public string? BusyText { get; set; }

    [Parameter] public bool IsBusy { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public bool Danger { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }

    [Parameter] public EventCallback OnConfirm { get; set; }
}
