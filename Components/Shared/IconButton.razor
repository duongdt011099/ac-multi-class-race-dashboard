<button type="button" class="wec-btn" title="@Title" disabled="@Disabled" @onclick="OnClick" @onclick:stopPropagation="StopPropagation">
    <i class="bi @Icon"></i>
</button>

@code {
    /// <summary>Bootstrap icon class such as bi-pencil.</summary>
    [Parameter, EditorRequired] public string Icon { get; set; } = string.Empty;

    [Parameter] public string? Title { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Keeps the click from reaching a clickable table row behind the button.</summary>
    [Parameter] public bool StopPropagation { get; set; }

    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
}
