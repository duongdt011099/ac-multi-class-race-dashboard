<div class="wec-modal-overlay @OverlayClass" @attributes="OverlayAttributes">
    <div class="wec-modal @SizeClass @ModalClass" @onclick:stopPropagation="CloseOnBackdropClick">
        <div class="wec-modal__header">
            <span>@Title</span>
            @if (OnClose.HasDelegate)
            {
                <button type="button" class="wec-modal__close" aria-label="Close" @onclick="OnClose">
                    <i class="bi bi-x-lg"></i>
                </button>
            }
        </div>
        <div class="wec-modal__body @BodyClass">
            @ChildContent
        </div>
        @if (Footer is not null)
        {
            <div class="wec-modal__footer">
                @Footer
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    [Parameter] public ModalSize Size { get; set; } = ModalSize.Default;

    /// <summary>Extra classes on the dimmed overlay, e.g. wec-modal-overlay--top.</summary>
    [Parameter] public string? OverlayClass { get; set; }

    /// <summary>Extra classes on the dialog itself.</summary>
    [Parameter] public string? ModalClass { get; set; }

    /// <summary>Extra classes on the body.</summary>
    [Parameter] public string? BodyClass { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Also close when the dimmed area around the dialog is clicked.</summary>
    [Parameter] public bool CloseOnBackdropClick { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public RenderFragment? Footer { get; set; }

    private string? SizeClass => Size switch
    {
        ModalSize.Small => "wec-modal--small",
        ModalSize.Wide => "wec-modal--wide",
        ModalSize.Wider => "wec-modal--wider",
        _ => null
    };

    // Only attached when backdrop closing is on, so otherwise every click inside a dialog does not round-trip.
    private IReadOnlyDictionary<string, object>? OverlayAttributes => CloseOnBackdropClick
        ? new Dictionary<string, object> { ["onclick"] = OnClose }
        : null;
}
