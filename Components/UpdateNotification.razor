@rendermode Interactive
@using System.Globalization
@using MulticlassRace.Services.Updates
@implements IDisposable

@if (isOpen && result is not null)
{
    <Modal Title="@HeaderTitle" Size="ModalSize.Wide" OnClose="DismissAsync">
        <ChildContent>
            @if (result.IsUpdateAvailable)
            {
                <p class="wec-update__summary">
                    Version <strong>v@(result.LatestVersion)</strong> is available.
                    You are running <strong>v@(result.CurrentVersion)</strong>.
                </p>
                @if (result.PublishedAt is { } publishedAt)
                {
                    <p class="wec-update__published">
                        Published @publishedAt.ToLocalTime().ToString("d MMM yyyy", CultureInfo.InvariantCulture)
                    </p>
                }
                @if (result.Installer is not null)
                {
                    <p class="wec-update__asset">
                        <i class="bi bi-file-earmark-arrow-down" aria-hidden="true"></i>
                        <span>@result.Installer.Name (@FormatSize(result.Installer.SizeInBytes))</span>
                    </p>
                }
                @if (InstallPhase is UpdateInstallPhase.Downloading or UpdateInstallPhase.Ready)
                {
                    var ready = InstallPhase == UpdateInstallPhase.Ready;
                    var percent = ready ? 100 : Installer.ProgressPercent;
                    <div class="wec-update-progress @(ready ? "wec-update-progress--ready" : null)" role="status" aria-live="polite">
                        <div class="wec-update-progress__head">
                            <span class="wec-update-progress__icon" aria-hidden="true">
                                <i class="bi @(ready ? "bi-shield-check" : "bi-cloud-arrow-down")"></i>
                            </span>
                            <div class="wec-update-progress__label">
                                <span class="wec-update-progress__title">
                                    @(ready ? "Ready to install" : "Downloading update")
                                </span>
                                <span class="wec-update-progress__sub">
                                    @if (ready)
                                    {
                                        @:Downloaded and verified. The dashboard will restart to install it.
                                    }
                                    else
                                    {
                                        @ProgressDetail
                                    }
                                </span>
                            </div>
                            <span class="wec-update-progress__percent">@percent<small>%</small></span>
                        </div>
                        <div class="wec-update-progress__track" role="progressbar" aria-label="Update download"
                             aria-valuemin="0" aria-valuemax="100" aria-valuenow="@percent">
                            <div class="wec-update-progress__fill" style="width: @(percent.ToString(CultureInfo.InvariantCulture))%"></div>
                        </div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(InstallError))
                {
                    <p class="wec-update__error">@InstallError</p>
                }
                @if (!string.IsNullOrWhiteSpace(truncatedNotes))
                {
                    <div class="wec-update__notes">@((MarkupString)ReleaseNotesMarkdown.ToHtml(truncatedNotes))</div>
                }
            }
            else if (result.HasError)
            {
                <p class="wec-update__summary">Could not check for updates.</p>
                <p class="wec-update__error">@result.ErrorMessage</p>
                <p class="wec-update__published">
                    You are running <strong>v@(result.CurrentVersion)</strong>.
                </p>
            }
            else
            {
                <p class="wec-update__summary">
                    Your version is up-to-date. You are running <strong>v@(result.CurrentVersion)</strong>.
                </p>
                <p class="wec-update__published">
                    Checked @result.CheckedAtUtc.ToLocalTime().ToString("d MMM yyyy HH:mm", CultureInfo.InvariantCulture)
                </p>
            }
        </ChildContent>
        <Footer>
            <button type="button" class="wec-modal__btn wec-modal__btn--secondary" @onclick="CheckForUpdateAsync" disabled="@CheckBlocked">
                @(isChecking ? "Checking..." : CheckBlocked ? "Up to date" : "Check for update")
            </button>
            @if (result.IsUpdateAvailable)
            {
                <button type="button" class="wec-modal__btn wec-modal__btn--secondary" @onclick="DismissAsync" disabled="@isDismissing">
                    Later
                </button>
                <a class="wec-modal__btn wec-modal__btn--secondary" href="@result.ReleaseUrl" target="_blank" rel="noopener">
                    View Release
                </a>
                @if (result.Installer is not null)
                {
                    @if (InstallPhase == UpdateInstallPhase.Ready)
                    {
                        <button type="button" class="wec-modal__btn wec-modal__btn--primary" @onclick="InstallAsync">
                            Restart &amp; Update
                        </button>
                    }
                    else if (InstallPhase == UpdateInstallPhase.Downloading)
                    {
                        <button type="button" class="wec-modal__btn wec-modal__btn--primary" disabled>
                            Downloading...
                        </button>
                    }
                    else if (InstallPhase == UpdateInstallPhase.Failed)
                    {
                        <button type="button" class="wec-modal__btn wec-modal__btn--secondary" @onclick="StartDownloadAsync">
                            Retry
                        </button>
                        <a class="wec-modal__btn wec-modal__btn--primary" href="@result.Installer.DownloadUrl" target="_blank" rel="noopener"
                           @onclick="DismissAsync">
                            Download Manually
                        </a>
                    }
                    else
                    {
                        <button type="button" class="wec-modal__btn wec-modal__btn--primary" @onclick="StartDownloadAsync">
                            Download &amp; Install
                        </button>
                    }
                }
            }
        </Footer>
    </Modal>
}
