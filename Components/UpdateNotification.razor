@rendermode InteractiveServer
@using System.Globalization
@implements IDisposable

@if (isOpen && result is not null)
{
    <Modal Title="@HeaderTitle" OnClose="DismissAsync">
        <ChildContent>
            @if (result.IsUpdateAvailable)
            {
                <p class="wec-update__summary">
                    Version <strong>v@(result.LatestVersion)</strong> is available.
                    You are running <strong>v@(result.CurrentVersion)</strong>.
                </p>
                @if (result.PublishedAt is { } publishedAt)
                {
                    <p class="wec-update__published">
                        Published @publishedAt.ToLocalTime().ToString("d MMM yyyy", CultureInfo.InvariantCulture)
                    </p>
                }
                @if (result.Installer is not null)
                {
                    <p class="wec-update__asset">
                        <i class="bi bi-file-earmark-arrow-down" aria-hidden="true"></i>
                        <span>@result.Installer.Name (@FormatSize(result.Installer.SizeInBytes))</span>
                    </p>
                }
                @if (!string.IsNullOrWhiteSpace(truncatedNotes))
                {
                    <div class="wec-update__notes">@truncatedNotes</div>
                }
            }
            else if (result.HasError)
            {
                <p class="wec-update__summary">Could not check for updates.</p>
                <p class="wec-update__error">@result.ErrorMessage</p>
                <p class="wec-update__published">
                    You are running <strong>v@(result.CurrentVersion)</strong>.
                </p>
            }
            else
            {
                <p class="wec-update__summary">
                    Your version is up-to-date. You are running <strong>v@(result.CurrentVersion)</strong>.
                </p>
                <p class="wec-update__published">
                    Checked @result.CheckedAtUtc.ToLocalTime().ToString("d MMM yyyy HH:mm", CultureInfo.InvariantCulture)
                </p>
            }
        </ChildContent>
        <Footer>
            <button type="button" class="wec-modal__btn wec-modal__btn--secondary" @onclick="CheckForUpdateAsync" disabled="@CheckBlocked">
                @(isChecking ? "Checking..." : CheckBlocked ? "Up to date" : "Check for update")
            </button>
            @if (result.IsUpdateAvailable)
            {
                <button type="button" class="wec-modal__btn wec-modal__btn--secondary" @onclick="DismissAsync" disabled="@isDismissing">
                    Later
                </button>
                <a class="wec-modal__btn wec-modal__btn--secondary" href="@result.ReleaseUrl" target="_blank" rel="noopener">
                    View Release
                </a>
                @if (result.Installer is not null)
                {
                    <a class="wec-modal__btn wec-modal__btn--primary" href="@result.Installer.DownloadUrl" target="_blank" rel="noopener"
                       @onclick="DismissAsync">
                        Download Update
                    </a>
                }
            }
        </Footer>
    </Modal>
}
