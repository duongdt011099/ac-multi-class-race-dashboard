@inherits LayoutComponentBase

<div class="wec-window-controls">
    <button type="button" class="wec-window-btn" title="Minimize" aria-label="Minimize window"
            onclick="window.chrome && window.chrome.webview && window.chrome.webview.postMessage('minimize')">
        <i class="bi bi-dash-lg"></i>
    </button>
    <button type="button" class="wec-window-btn wec-window-btn--close" title="Close" aria-label="Close window"
            onclick="window.chrome && window.chrome.webview && window.chrome.webview.postMessage('close')">
        <i class="bi bi-x-lg"></i>
    </button>
</div>

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main class="background-image">
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<UpdateNotification />
<UserGuide />
<SafetyCarPanelHost />
<LuaResultImportPrompt />
<SeasonCompletionHost />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
