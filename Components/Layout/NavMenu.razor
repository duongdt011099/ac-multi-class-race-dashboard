<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <img src="logo.png" alt="multi-class-race-dashboard" class="wec-navbar-brand__logo" />
        </a>
    </div>
</div>

@rendermode InteractiveServer
@using MulticlassRace.ViewModels
@inject MulticlassRace.Services.Abstractions.IAssettoCorsaGameConfigService ConfigService
@inject MulticlassRace.Services.Abstractions.IDriverService DriverService
@inject MulticlassRace.Services.GameConfigChangeNotifier ConfigNotifier
@inject MulticlassRace.Services.DriverDataChangeNotifier DriverNotifier
@inject NavigationManager Nav
@implements IDisposable

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    @if (!isConfigured)
    {
        <div class="wec-nav-warning" role="alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            <span>Game hasn't been configured yet. Open <strong>Game Config</strong> to set it up.</span>
        </div>
    }

    <nav class="nav flex-column">
        <div class="wec-nav-human">
            @if (humanDriver is not null)
            {
                <div class="wec-nav-human__title">
                    <span class="bi bi-person-nav" aria-hidden="true"></span> Current Human Driver
                </div>
                <div class="wec-nav-human__card">
                    <div class="wec-nav-human__row">
                        @if (!string.IsNullOrWhiteSpace(humanDriver.CarImageUrl))
                        {
                            <img src="@humanDriver.CarImageUrl" alt="@humanDriver.CarDisplayName" class="wec-nav-human__car-img" onerror="this.style.display='none'" />
                        }
                        <div class="wec-nav-human__info">
                            <span class="wec-nav-human__name">@humanDriver.DriverName</span>
                            <span class="wec-nav-human__car">@humanDriver.CarDisplayName</span>
                        </div>
                    </div>
                    <div class="wec-nav-human__row wec-nav-human__team">
                        @if (!string.IsNullOrWhiteSpace(humanDriver.TeamLogo))
                        {
                            <img src="@humanDriver.TeamLogo" alt="@humanDriver.TeamName" class="wec-nav-human__logo" />
                        }
                        <span>@(humanDriver.TeamName ?? "No team")</span>
                    </div>
                </div>
            }
            else
            {
                <div class="wec-nav-warning" role="alert">
                    <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                    <span>No human driver selected.</span>
                </div>
            }
        </div>

        <div class="nav-item px-3">
            @if (isConfigured)
            {
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="bi bi-trophy-nav-menu" aria-hidden="true"></span> Championship
                </NavLink>
            }
            else
            {
                <span class="nav-link wec-nav-disabled" aria-disabled="true">
                    <span class="bi bi-trophy-nav-menu" aria-hidden="true"></span> Championship
                </span>
            }
        </div>

        <div class="nav-item px-3">
            @if (isConfigured)
            {
                <NavLink class="nav-link" href="teams">
                    <span class="bi bi-car-nav-menu" aria-hidden="true"></span> Teams
                </NavLink>
            }
            else
            {
                <span class="nav-link wec-nav-disabled" aria-disabled="true">
                    <span class="bi bi-car-nav-menu" aria-hidden="true"></span> Teams
                </span>
            }
        </div>

        <div class="nav-item px-3">
            @if (isConfigured)
            {
                <NavLink class="nav-link" href="drivers">
                    <span class="bi bi-helmet-nav-menu" aria-hidden="true"></span> Drivers
                </NavLink>
            }
            else
            {
                <span class="nav-link wec-nav-disabled" aria-disabled="true">
                    <span class="bi bi-helmet-nav-menu" aria-hidden="true"></span> Drivers
                </span>
            }
        </div>

        <div class="nav-item px-3">
            @if (isConfigured)
            {
                <NavLink class="nav-link" href="races">
                    <span class="bi bi-checkered-flag-nav-menu" aria-hidden="true"></span> Races
                </NavLink>
            }
            else
            {
                <span class="nav-link wec-nav-disabled" aria-disabled="true">
                    <span class="bi bi-checkered-flag-nav-menu" aria-hidden="true"></span> Races
                </span>
            }
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="gameconfig">
                <span class="bi bi-controller-nav-menu" aria-hidden="true"></span> Game Config
            </NavLink>
        </div>

        <div class="nav-item px-3">
            @if (isConfigured)
            {
                <NavLink class="nav-link" href="pointsettings">
                    <span class="bi bi-scoreboard-nav-menu" aria-hidden="true"></span> Point Settings
                </NavLink>
            }
            else
            {
                <span class="nav-link wec-nav-disabled" aria-disabled="true">
                    <span class="bi bi-scoreboard-nav-menu" aria-hidden="true"></span> Point Settings
                </span>
            }
        </div>
    </nav>
</div>

@code {
    private bool isConfigured;
    private DriverModel? humanDriver;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        ConfigNotifier.Changed += OnConfigChanged;
        DriverNotifier.Changed += OnDriverChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadStateAsync();
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        try
        {
            await LoadStateAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
        }
    }

    private async void OnConfigChanged()
    {
        try
        {
            await LoadStateAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
        }
    }

    private async void OnDriverChanged()
    {
        try
        {
            await LoadStateAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
        }
    }

    private async Task LoadStateAsync()
    {
        var config = await ConfigService.GetAsync();
        isConfigured = !string.IsNullOrWhiteSpace(config?.GamePath);

        var drivers = await DriverService.GetActiveDriversAsync();
        humanDriver = drivers.FirstOrDefault(d => d.IsHuman);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        ConfigNotifier.Changed -= OnConfigChanged;
        DriverNotifier.Changed -= OnDriverChanged;
    }
}

