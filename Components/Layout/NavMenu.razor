<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <img src="logo.png" alt="multi-class-race-dashboard" class="wec-navbar-brand__logo" />
        </a>
    </div>
</div>

@rendermode InteractiveServer
@implements IDisposable

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    @if (!isConfigured)
    {
        <div class="wec-nav-warning" role="alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            <span>The Assetto Corsa folder has not been found, so everything else stays switched off.
            Run the dashboard setup again and point it at the game.</span>
        </div>
    }

    <nav class="nav flex-column">
        <button type="button" class="wec-nav-version" @onclick="OpenUpdateDialog" title="@VersionTitle">
            <span class="wec-nav-version__label">Version</span>
            <span class="wec-nav-version__number">v@(VersionProvider.CurrentVersion)</span>
            @if (hasUpdate)
            {
                <span class="wec-nav-version__dot" aria-label="Update available"></span>
            }
        </button>

        <div class="wec-nav-human">
            @if (humanDriver is not null)
            {
                <div class="wec-nav-human__title">
                    <span class="bi bi-person-nav" aria-hidden="true"></span> Current Human Driver
                </div>
                <div class="wec-nav-human__card">
                    <div class="wec-nav-human__row">
                        @if (!string.IsNullOrWhiteSpace(humanDriver.CarImageUrl))
                        {
                            <img src="@humanDriver.CarImageUrl" alt="@humanDriver.CarDisplayName" class="wec-nav-human__car-img" onerror="this.style.display='none'" />
                        }
                        <div class="wec-nav-human__info">
                            <span class="wec-nav-human__name">@humanDriver.DriverName</span>
                            <span class="wec-nav-human__car">@humanDriver.CarDisplayName</span>
                        </div>
                    </div>
                    <div class="wec-nav-human__row wec-nav-human__team">
                        @if (!string.IsNullOrWhiteSpace(humanDriver.TeamLogo))
                        {
                            <img src="@humanDriver.TeamLogo" alt="@humanDriver.TeamName" class="wec-nav-human__logo" />
                        }
                        <span>@(humanDriver.TeamName ?? "No team")</span>
                    </div>
                </div>
            }
            else
            {
                <div class="wec-nav-warning" role="alert">
                    <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                    <span>No human driver selected.</span>
                </div>
            }
        </div>

        <NavItem Href="" Icon="bi-trophy-nav-menu" Text="Championship" Match="NavLinkMatch.All" Enabled="isConfigured" />
        <NavItem Href="teams" Icon="bi-car-nav-menu" Text="Teams" Enabled="isConfigured" />
        <NavItem Href="drivers" Icon="bi-helmet-nav-menu" Text="Drivers" Enabled="isConfigured" />
        <NavItem Href="races" Icon="bi-checkered-flag-nav-menu" Text="Races" Enabled="isConfigured" />
        <NavItem Href="gameconfig" Icon="bi-controller-nav-menu" Text="Game Config" />
        <NavItem Href="class-settings" Icon="bi-diagram-3-fill-nav-menu" Text="Class Settings" Enabled="isConfigured" />
        <NavItem Href="pointsettings" Icon="bi-scoreboard-nav-menu" Text="Point Settings" Enabled="isConfigured" />
    </nav>

    <div class="wec-nav-copyright">Copyrights @DateTime.Now.Year @@duongdt011099</div>
</div>
