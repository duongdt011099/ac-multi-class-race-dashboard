@page "/races"
@rendermode InteractiveServer
@using MulticlassRace.Models
@using MulticlassRace.ViewModels
@using multi_class_race_dashboard.Components.Features.Races
@inherits PageBase

<PageHeader Title="Races" />

<FilterBar>
    <FilterItem For="filter-championship" Label="Championship">
        <AppSelect Id="filter-championship" Value="@SelectedChampionshipId" ValueChanged="HandleChampionshipChanged"
                   EmptyLabel="Select championship..." Options="ChampionshipOptions" />
    </FilterItem>

    @if (selectedChampionship is not null)
    {
        <FilterItem For="filter-season" Label="Season">
            <AppSelect Id="filter-season" Value="@SelectedSeasonId" ValueChanged="HandleSeasonChanged"
                       EmptyLabel="Select season..." Options="SeasonOptions" />
        </FilterItem>

        <div class="wec-breadcrumb">@selectedChampionship.ChampionshipName @(selectedSeason is not null ? $"›      {selectedSeason.SeasonName}" : "")</div>
    }
</FilterBar>

@if (races is not null)
{
    <div class="wec-toolbar">
        <ToolbarButton Icon="bi-trophy-fill" Disabled="!HasSeason" OnClick="OpenStandings">Standings</ToolbarButton>
        <ToolbarButton Icon="bi-plus-lg" Disabled="!HasSeason" OnClick="OpenRaceCreate">Add Race</ToolbarButton>
    </div>
}

<DataTable IsEmpty="@(!HasSeason || races is null || !DisplayRaces.Any())" ColumnCount="7"
           EmptyText="@(!HasSeason ? "Select a championship and a season to view races." : races is null ? "Loading races..." : "No races found. Click Add Race to create one.")">
    <Header>
        <SortableHeader TColumn="SortColumn" Column="SortColumn.Race" Current="sort.Column"
                        Descending="sort.Descending" OnSort="sort.Toggle">Race</SortableHeader>
        <th>Country</th>
        <th>Track</th>
        <th>Point Setting</th>
        <th>Class Setting</th>
        <SortableHeader TColumn="SortColumn" Column="SortColumn.Status" Current="sort.Column"
                        Descending="sort.Descending" OnSort="sort.Toggle">Status</SortableHeader>
        <th class="wec-table__actions">Actions</th>
    </Header>
    <Body>
        @foreach (var race in DisplayRaces)
        {
            var countryFlag = Countries.GetFlag(race.Country);
            <tr class="wec-row-clickable" title="View sessions" @onclick="() => viewingSessionsFor = race">
                <td>@race.RaceName</td>
                <td>
                    @if (!string.IsNullOrEmpty(countryFlag))
                    {
                        <span class="wec-race-flag-emoji">@countryFlag</span>
                    }
                    @(string.IsNullOrWhiteSpace(race.Country) ? "—" : race.Country)
                </td>
                <td>
                    @if (string.IsNullOrWhiteSpace(race.TrackName))
                    {
                        <span>—</span>
                    }
                    else
                    {
                        <div class="wec-race-track">
                            <img class="wec-race-track__thumb" src="@RaceFormat.TrackImageUrl(race.TrackName, race.TrackLayout, "preview")" alt="Track preview" />
                            <div class="wec-race-track__meta">
                                <span class="wec-race-track__name">@race.TrackName</span>
                                @if (!string.IsNullOrWhiteSpace(race.TrackLayout))
                                {
                                    <span class="wec-race-track__layout">@race.TrackLayout</span>
                                }
                            </div>
                        </div>
                    }
                </td>
                <td>@(string.IsNullOrWhiteSpace(race.PointSettingName) ? "—" : race.PointSettingName)</td>
                <td>
                    <span class="wec-badge wec-badge--default">@(string.IsNullOrWhiteSpace(race.ClassSettingName) ? "Not set" : race.ClassSettingName)</span>
                </td>
                <td>
                    <span class="wec-status @RaceFormat.StatusClass(race.Status)">
                        @RaceFormat.StatusLabel(race.Status)
                    </span>
                </td>
                <td class="wec-table__actions">
                    <IconButton Icon="bi-pencil" Title="@($"Edit {race.RaceName}")" StopPropagation="true"
                                OnClick="() => OpenRaceEdit(race)" />
                    <IconButton Icon="bi-trash" Title="@($"Delete {race.RaceName}")" StopPropagation="true"
                                OnClick="() => confirmDeleteRace = race" />
                </td>
            </tr>
        }
    </Body>
</DataTable>

@if (isOpeningStandings)
{
    <RaceStandingsModal Standings="driverStandings" Colors="classColors" OnClose="() => isOpeningStandings = false" />
}

@if (editingRace is not null)
{
    <RaceEditModal Race="editingRace" IsCreating="isCreatingRace" IsSaving="isSavingRace"
                   ChampionshipName="@selectedChampionship?.ChampionshipName" SeasonName="@selectedSeason?.SeasonName"
                   Tracks="availableTracks" PointSettings="pointSettings" ClassSettings="classSettings"
                   InitialLayouts="editingLayouts" InitialLapTimeMs="editingLapTimeMs"
                   OnSave="SaveRaceAsync" OnCancel="CancelRaceEdit" />
}

@if (confirmDeleteRace is not null)
{
    <ConfirmDialog Title="Delete Race" IsBusy="isDeletingRace"
                   OnCancel="() => confirmDeleteRace = null" OnConfirm="DeleteRaceAsync">
        Delete @confirmDeleteRace.RaceName? This also removes its sessions and driver standings.
    </ConfirmDialog>
}

@if (viewingSessionsFor is not null)
{
    <RaceSessionsModal @key="viewingSessionsFor.RaceId" Race="viewingSessionsFor" ClassSettings="classSettings" Colors="classColors"
                       ChampionshipName="@selectedChampionship?.ChampionshipName" SeasonName="@selectedSeason?.SeasonName"
                       OnClose="CloseSessionsAsync" OnLoadFailed="() => viewingSessionsFor = null"
                       OnRaceResultChanged="LoadRacesAsync" />
}
