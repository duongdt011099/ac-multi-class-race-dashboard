@page "/teams"
@rendermode Interactive
@using MulticlassRace.ViewModels
@using multi_class_race_dashboard.Components.Features.Teams
@inherits PageBase

<PageHeader Title="Teams" />

@if (teams is null)
{
    <p>Loading...</p>
}
else
{
    var paged = PagedTeams;

    <div class="wec-toolbar">
        <ToolbarButton Icon="bi-plus-lg" OnClick="OpenCreate">New Team</ToolbarButton>
        <ToolbarButton Icon="@(isBatchMode ? (selectedIds.Count == 0 ? "bi-x-lg" : "bi-check-lg") : "bi-pencil-square")"
                       OnClick="HandleBatchButton">
            @(!isBatchMode ? "Batch Edit" : selectedIds.Count == 0 ? "Cancel Edit" : "Open Editor")
        </ToolbarButton>
    </div>

    <FilterBar>
        <SearchFilter Id="filter-team-search" Placeholder="Search team or driver name..." Value="@searchTerm"
                      ValueChanged="HandleSearchChanged" />
        <FilterItem For="filter-team-class" Label="Class">
            <AppSelect Id="filter-team-class" Value="@selectedClassFilter" ValueChanged="HandleClassFilterChanged"
                       EmptyLabel="All classes" Options="ClassFilterOptions" />
        </FilterItem>
    </FilterBar>

    <DataTable IsEmpty="@(paged.TotalCount == 0)" ColumnCount="@(isBatchMode ? 5 : 4)" EmptyText="No teams found">
        <Header>
            @if (isBatchMode)
            {
                <th class="wec-table__check">
                    <input type="checkbox" title="Select all on page" checked="@AllPageSelected(paged)"
                           @onchange="e => ToggleAll(paged, (bool)e.Value!)" />
                </th>
            }
            <th>#</th>
            <SortableHeader TColumn="TeamSortColumn" Column="TeamSortColumn.Team" Current="sort.Column"
                            Descending="sort.Descending" OnSort="sort.Toggle">Team</SortableHeader>
            <SortableHeader TColumn="TeamSortColumn" Column="TeamSortColumn.Class" Current="sort.Column"
                            Descending="sort.Descending" OnSort="sort.Toggle">Class</SortableHeader>
            <SortableHeader TColumn="TeamSortColumn" Column="TeamSortColumn.Status" Current="sort.Column"
                            Descending="sort.Descending" OnSort="sort.Toggle">Status</SortableHeader>
        </Header>
        <Body>
            @{
                var index = paged.FirstIndex;
            }
            @foreach (var team in paged.Items)
            {
                index++;
                var current = team;
                <tr class="wec-row-clickable" title="@($"Edit {team.TeamName}")" @onclick="() => HandleRowClick(current)">
                    @if (isBatchMode)
                    {
                        <td class="wec-table__check" @onclick:stopPropagation="true">
                            <input type="checkbox" title="@($"Select {team.TeamName}")"
                                   checked="@selectedIds.Contains(team.TeamId)"
                                   @onchange="e => ToggleSelected(current.TeamId, (bool)e.Value!)" />
                        </td>
                    }
                    <td class="wec-table__position">@index</td>
                    <td><TeamCell Name="@team.TeamName" Logo="@team.TeamLogo" ShowInitialsFallback="true" /></td>
                    <td><ClassBadges Tags="team.ClassTags" /></td>
                    <td><StatusBadge IsActive="team.IsActive" /></td>
                </tr>
            }
        </Body>
        <Footer>
            <Pagination Page="paged.Page" TotalPages="paged.TotalPages" PageChanged="page => currentPage = page" />
        </Footer>
    </DataTable>
}

@if (showBatchModal)
{
    <TeamBatchEditModal Count="selectedIds.Count" IsSaving="isSaving" ClassOptions="classItems"
                        OnSave="SaveBatchAsync" OnCancel="() => showBatchModal = false" />
}

@if (editingTeam is not null)
{
    <TeamEditModal Team="editingTeam" IsCreating="isCreating" IsSaving="isSaving" Drivers="editingDrivers"
                   ClassOptions="classItems" OnSave="SaveTeamAsync" OnCancel="CancelEdit" />
}
