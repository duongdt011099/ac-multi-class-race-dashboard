@page "/pointsettings"
@rendermode InteractiveServer
@using MulticlassRace.ViewModels
@inherits PageBase

<PageHeader Title="Point Settings" />

<div class="wec-toolbar">
    <ToolbarButton Icon="bi-plus-lg" OnClick="OpenCreate">Add Point Setting</ToolbarButton>
</div>

<DataTable IsEmpty="@(settings is null || !settings.Any())" ColumnCount="4"
           EmptyText="@(settings is null ? "Loading point settings..." : "No point settings yet. Click Add Point Setting to create one.")">
    <Header>
        <th>Name</th>
        <th>Default</th>
        <th>Points</th>
        <th class="wec-table__actions">Actions</th>
    </Header>
    <Body>
        @foreach (var setting in settings!)
        {
            <tr>
                <td>@setting.SettingName</td>
                <td>
                    @if (setting.IsDefault)
                    {
                        <span class="wec-badge wec-badge--default">Default</span>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </td>
                <td>
                    <span class="wec-points-preview">@PointSettingForms.FormatPreview(setting.Config)</span>
                </td>
                <td class="wec-table__actions">
                    <IconButton Icon="bi-pencil" Title="@($"Edit {setting.SettingName}")" OnClick="() => OpenEdit(setting)" />
                    <IconButton Icon="bi-trash" Title="@($"Delete {setting.SettingName}")" OnClick="() => confirmDelete = setting" />
                </td>
            </tr>
        }
    </Body>
</DataTable>

@if (editingSetting is not null)
{
    <Modal Title="@(isCreating ? "New Point Setting" : "Edit Point Setting")" Size="ModalSize.Wide" OnClose="CancelEdit">
        <ChildContent>
            <div class="wec-form-row">
                <FormField For="setting-name" Label="Name" CssClass="wec-form-field--wide">
                    <input id="setting-name" type="text" placeholder="e.g. WEC Season" @bind="editingSetting.SettingName" />
                </FormField>
                <CheckboxField Id="setting-default" Label="Is Default" @bind-Value="editingSetting.IsDefault"
                               Disabled="!CanToggleDefault"
                               CssClass="@(CanToggleDefault ? null : "wec-form-field--disabled")"
                               Title="@(CanToggleDefault ? null : $"Another point setting is already the default: {DefaultSettingName}")" />
            </div>

            @if (!CanToggleDefault)
            {
                <p class="wec-form-hint">
                    <i class="bi bi-info-circle" aria-hidden="true"></i>
                    <span><strong>@DefaultSettingName</strong> is currently the default. Uncheck it first to make this the default.</span>
                </p>
            }

            <div class="wec-setting-entries">
                <div class="wec-setting-entries__header">Points Table</div>
                <table class="wec-table">
                    <thead>
                        <tr>
                            <th>Position</th>
                            <th>Points</th>
                            <th class="wec-table__actions"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < editingSetting.Entries.Count; i++)
                        {
                            var index = i;
                            <tr>
                                <td class="wec-setting-entry-position">@editingSetting.Entries[index].Position</td>
                                <td>
                                    <input class="wec-setting-entry-input" type="number" min="0" step="1" placeholder="25" @bind="editingSetting.Entries[index].Points" />
                                </td>
                                <td class="wec-table__actions">
                                    <IconButton Icon="bi-x-lg" Title="Remove row" OnClick="() => RemoveEntry(index)" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <ToolbarButton Icon="bi-plus-lg" OnClick="AddEntry">Add Entry</ToolbarButton>
            </div>
        </ChildContent>
        <Footer>
            <ModalActions ConfirmText="@(isCreating ? "Create" : "Save")" BusyText="Saving..." IsBusy="isSaving"
                          OnCancel="CancelEdit" OnConfirm="SaveSettingAsync" />
        </Footer>
    </Modal>
}

@if (confirmDelete is not null)
{
    <ConfirmDialog Title="Delete Point Setting" IsBusy="isDeleting"
                   OnCancel="() => confirmDelete = null" OnConfirm="DeleteSettingAsync">
        Delete @confirmDelete.SettingName?
    </ConfirmDialog>
}
