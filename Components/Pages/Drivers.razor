@page "/drivers"
@rendermode InteractiveServer
@using MulticlassRace.ViewModels
@using multi_class_race_dashboard.Components.Features.Drivers
@inherits PageBase

<PageHeader Title="Drivers" />

@if (drivers is null)
{
    <p>Loading...</p>
}
else
{
    var paged = PagedDrivers;

    <div class="wec-toolbar">
        <ToolbarButton Icon="bi-plus-lg" OnClick="OpenCreate">New Driver</ToolbarButton>
        <ToolbarButton Icon="bi-upload" Disabled="isImporting" OnClick="OpenPresetPicker">
            @(isImporting ? "Importing..." : "Import Assetto Corsa Preset")
        </ToolbarButton>
        <ToolbarButton Icon="@(isBatchMode ? (selectedIds.Count == 0 ? "bi-x-lg" : "bi-check-lg") : "bi-pencil-square")"
                       OnClick="HandleBatchButton">
            @(!isBatchMode ? "Batch Edit" : selectedIds.Count == 0 ? "Cancel Edit" : "Open Editor")
        </ToolbarButton>
    </div>

    <FilterBar>
        <SearchFilter Id="filter-driver-search" Placeholder="Search driver or team name..." Value="@searchTerm"
                      ValueChanged="HandleSearchChanged" />
        <FilterItem For="filter-driver-class" Label="Class">
            <AppSelect Id="filter-driver-class" Value="@selectedClassFilter" ValueChanged="HandleClassFilterChanged"
                       EmptyLabel="All classes" Options="ClassFilterOptions" />
        </FilterItem>
    </FilterBar>

    <DataTable IsEmpty="@(paged.TotalCount == 0)" ColumnCount="@(isBatchMode ? 12 : 11)" EmptyText="No drivers found">
        <Header>
            @if (isBatchMode)
            {
                <th class="wec-table__check">
                    <input type="checkbox" title="Select all on page" checked="@AllPageSelected(paged)"
                           @onchange="e => ToggleAll(paged, (bool)e.Value!)" />
                </th>
            }
            <th>#</th>
            <th>No.</th>
            <th>Car</th>
            <SortableHeader TColumn="DriverSortColumn" Column="DriverSortColumn.Driver" Current="sort.Column"
                            Descending="sort.Descending" OnSort="sort.Toggle">Driver</SortableHeader>
            <th>Nationality</th>
            <th>Team</th>
            <th>Class</th>
            <th>AI Strength</th>
            <th>AI Aggression</th>
            <SortableHeader TColumn="DriverSortColumn" Column="DriverSortColumn.Status" Current="sort.Column"
                            Descending="sort.Descending" OnSort="sort.Toggle">Status</SortableHeader>
            <th class="wec-table__actions">Actions</th>
        </Header>
        <Body>
            @{
                var index = paged.FirstIndex;
            }
            @foreach (var driver in paged.Items)
            {
                index++;
                var current = driver;
                <tr>
                    @if (isBatchMode)
                    {
                        <td class="wec-table__check">
                            <input type="checkbox" title="@($"Select {driver.DriverName}")"
                                   checked="@selectedIds.Contains(driver.DriverId)"
                                   @onchange="e => ToggleSelected(current.DriverId, (bool)e.Value!)" />
                        </td>
                    }
                    <td class="wec-table__position">@index</td>
                    <td>
                        @if (!string.IsNullOrEmpty(driver.LiveryImageUrl))
                        {
                            <img src="@driver.LiveryImageUrl" class="wec-drivers__livery" alt="@driver.Car livery"
                                 onerror="this.style.display='none'" />
                        }
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(driver.CarImageUrl))
                        {
                            <button type="button" class="wec-drivers__car-btn" title="View bigger"
                                    @onclick="() => OpenCarImageAsync(driver)">
                                <img src="@driver.CarImageUrl" class="wec-drivers__car-img" alt="@driver.Car"
                                     onerror="this.style.display='none'" />
                            </button>
                        }
                    </td>
                    <td>@driver.DriverName</td>
                    <td>@driver.Nationality</td>
                    <td>
                        @if (driver.TeamName is not null)
                        {
                            <TeamCell Name="@driver.TeamName" Logo="@driver.TeamLogo" />
                        }
                    </td>
                    <td><ClassBadges Tags="driver.ClassTags" /></td>
                    <td>@(driver.DriverStrength?.ToString() ?? "—")</td>
                    <td>@(driver.DriverAgression?.ToString() ?? "—")</td>
                    <td><StatusBadge IsActive="driver.IsActive" /></td>
                    <td class="wec-table__actions">
                        <IconButton Icon="bi-pencil" Title="@($"Edit {driver.DriverName}")" OnClick="() => OpenEdit(driver)" />
                        <IconButton Icon="bi-trash" Title="@($"Delete {driver.DriverName}")" OnClick="() => confirmDeleteDriver = driver" />
                    </td>
                </tr>
            }
        </Body>
        <Footer>
            <Pagination Page="paged.Page" TotalPages="paged.TotalPages" PageChanged="page => currentPage = page" />
        </Footer>
    </DataTable>
}

@if (editingDriver is not null)
{
    <DriverEditModal Driver="editingDriver" IsCreating="isCreating" IsSaving="isSaving"
                     CarOptions="carOptions" IsLoadingCars="isLoadingCars" TeamOptions="teamOptions"
                     CanToggleHuman="CanToggleHuman" HumanDriverName="@HumanDriver?.DriverName"
                     OnSave="SaveDriverAsync" OnCancel="CancelEdit" OnDelete="RequestDeleteEditing" />
}

@if (showBatchModal)
{
    <DriverBatchEditModal Count="selectedIds.Count" IsSaving="isSaving"
                          OnSave="SaveBatchAsync" OnCancel="() => showBatchModal = false" />
}

@if (confirmDeleteDriver is not null)
{
    <ConfirmDialog Title="Delete Driver" CancelText="No" ConfirmText="Yes" IsBusy="isDeleting"
                   OnCancel="() => confirmDeleteDriver = null" OnConfirm="DeleteDriverAsync">
        Do you want to delete this driver? This action could not be undone.
    </ConfirmDialog>
}

@if (viewingCar is not null)
{
    <Modal Title="@viewingCarDisplayName" Size="ModalSize.Wider" CloseOnBackdropClick="true" OnClose="CloseCarImage">
        <ChildContent>
            <img src="@viewingCar.CarImageUrl" class="wec-image-viewer__img" alt="@viewingCarDisplayName" />
        </ChildContent>
        <Footer>
            <button type="button" class="wec-modal__btn wec-modal__btn--secondary" @onclick="CloseCarImage">Close</button>
        </Footer>
    </Modal>
}

<FolderPicker FieldLabel="Preset" Title="Select Assetto Corsa Preset" InputId="driver-preset-path" Value="presetPath"
              RootPath="presetPath" ValueChanged="ImportPresetFromPath" @ref="presetPicker" ShowBrowseButton="false"
              IncludeFiles="true" />
