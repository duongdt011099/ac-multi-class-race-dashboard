@page "/"
@rendermode InteractiveServer
@using MulticlassRace.ViewModels
@inherits PageBase

<PageHeader Title="Championship" />

@if (championships is null)
{
    <p>Loading...</p>
}
else
{
    <div class="wec-toolbar">
        <ToolbarButton Icon="bi-plus-lg" OnClick="OpenCreate">New Championship</ToolbarButton>
    </div>

    <DataTable IsEmpty="@(!DisplayChampionships.Any())" ColumnCount="5" EmptyText="No championships found">
        <Header>
            <th>#</th>
            <SortableHeader TColumn="SortColumn" Column="SortColumn.Championship" Current="sort.Column"
                            Descending="sort.Descending" OnSort="sort.Toggle">Championship</SortableHeader>
            <th>Seasons</th>
            <SortableHeader TColumn="SortColumn" Column="SortColumn.Status" Current="sort.Column"
                            Descending="sort.Descending" OnSort="sort.Toggle">Status</SortableHeader>
            <th class="wec-table__actions">Actions</th>
        </Header>
        <Body>
            @{
                var index = 0;
            }
            @foreach (var championship in DisplayChampionships)
            {
                index++;
                <tr class="wec-row-clickable" title="Manage seasons" @onclick="() => OpenSeasons(championship)">
                    <td class="wec-table__position">@index</td>
                    <td>@championship.ChampionshipName</td>
                    <td>@championship.SeasonCount</td>
                    <td><StatusBadge IsActive="championship.IsActive" /></td>
                    <td class="wec-table__actions">
                        <IconButton Icon="bi-pencil" Title="@($"Edit {championship.ChampionshipName}")" StopPropagation="true"
                                    OnClick="() => OpenEdit(championship)" />
                        <IconButton Icon="bi-trash" Title="@($"Delete {championship.ChampionshipName}")" StopPropagation="true"
                                    OnClick="() => confirmDeleteChampionship = championship" />
                    </td>
                </tr>
            }
        </Body>
    </DataTable>
}

@if (editingChampionship is not null)
{
    <Modal Title="@(isCreating ? "New Championship" : "Edit Championship")" OnClose="CancelEdit">
        <ChildContent>
            <FormField For="championship-name" Label="Championship Name">
                <input id="championship-name" type="text" @bind="editingChampionship.ChampionshipName" />
            </FormField>

            <CheckboxField Id="championship-active" Label="Is Active" @bind-Value="editingChampionship.IsActive" />
        </ChildContent>
        <Footer>
            <ModalActions ConfirmText="@(isCreating ? "Create" : "Save")" BusyText="Saving..." IsBusy="isSaving"
                          OnCancel="CancelEdit" OnConfirm="SaveChampionshipAsync" />
        </Footer>
    </Modal>
}

@if (confirmDeleteChampionship is not null)
{
    <ConfirmDialog Title="Delete Championship" IsBusy="isDeleting"
                   OnCancel="() => confirmDeleteChampionship = null" OnConfirm="DeleteChampionshipAsync">
        Delete @confirmDeleteChampionship.ChampionshipName? This permanently removes its seasons, races and standings.
    </ConfirmDialog>
}

@if (selectedChampionship is not null)
{
    <Modal Title="@($"{selectedChampionship.ChampionshipName} — Seasons")" OnClose="CloseSeasons">
        <div class="wec-seasons__add">
            <input type="text" placeholder="Season name..." @bind="newSeasonName" @bind:event="oninput"
                   @onkeydown="HandleNewSeasonEnter" />
            <ToolbarButton OnClick="AddSeasonAsync" Disabled="isAddingSeason">
                @(isAddingSeason ? "Adding..." : "Add Season")
            </ToolbarButton>
        </div>

        @if (seasons is null)
        {
            <div class="wec-seasons__empty">Loading seasons...</div>
        }
        else if (!seasons.Any())
        {
            <div class="wec-seasons__empty">No seasons yet</div>
        }
        else
        {
            @foreach (var season in seasons)
            {
                <div class="wec-seasons__row">
                    <span class="wec-seasons__name">@season.SeasonName</span>
                    <span class="wec-seasons__races">@season.RaceCount race@(season.RaceCount == 1 ? "" : "s")</span>
                    <IconButton Icon="bi-flag" Title="@($"View races for {season.SeasonName}")" OnClick="() => NavigateToRaces(season)" />
                    <IconButton Icon="bi-files" Title="@($"Clone {season.SeasonName}")" OnClick="() => OpenCloneDialog(season)" />
                    <IconButton Icon="bi-trash" Title="@($"Delete {season.SeasonName}")" OnClick="() => confirmDeleteSeason = season" />
                </div>
            }
        }
    </Modal>
}

@if (confirmDeleteSeason is not null)
{
    <ConfirmDialog Title="Delete Season" IsBusy="isDeletingSeason"
                   OnCancel="() => confirmDeleteSeason = null" OnConfirm="DeleteSeasonAsync">
        Delete @confirmDeleteSeason.SeasonName? This also removes its races.
    </ConfirmDialog>
}

@if (cloningSeason is not null)
{
    <Modal Title="Clone Season" Size="ModalSize.Small" OnClose="CloseCloneDialog">
        <ChildContent>
            <FormField For="clone-season-name" Label="Season Name">
                <input id="clone-season-name" type="text" @bind="cloneSeasonName" @bind:event="oninput"
                       @onkeydown="HandleCloneNameEnter" />
            </FormField>
            <p class="wec-form-hint">Races are copied as empty race shells, without sessions or standings.</p>
        </ChildContent>
        <Footer>
            <ModalActions ConfirmText="Clone" BusyText="Cloning..." IsBusy="isCloningSeason"
                          OnCancel="CloseCloneDialog" OnConfirm="CloneSeasonAsync" />
        </Footer>
    </Modal>
}
