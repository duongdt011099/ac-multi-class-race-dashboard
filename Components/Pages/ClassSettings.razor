@page "/class-settings"
@rendermode InteractiveServer
@using MulticlassRace.ViewModels
@inherits PageBase

<PageHeader Title="Class Settings" />

@if (settings is null)
{
    <p>Loading...</p>
}
else
{
    <div class="wec-toolbar">
        <ToolbarButton Icon="bi-plus-lg" OnClick="OpenCreate">New Class Setting</ToolbarButton>
    </div>

    <DataTable IsEmpty="@(!settings.Any())" ColumnCount="4" EmptyText="No class settings configured.">
        <Header>
            <th>Name</th>
            <th>Default</th>
            <th>Classes</th>
            <th class="wec-table__actions">Actions</th>
        </Header>
        <Body>
            @foreach (var setting in settings)
            {
                <tr>
                    <td>@setting.ClassSettingName</td>
                    <td>@(setting.IsDefault ? "Yes" : "No")</td>
                    <td>
                        <div class="wec-table__classes">
                            @foreach (var item in setting.Items.OrderBy(i => i.Order))
                            {
                                <span class="wec-badge" style="background-color: @item.Color">@item.Name</span>
                            }
                        </div>
                    </td>
                    <td class="wec-table__actions">
                        <IconButton Icon="bi-pencil" Title="@($"Edit {setting.ClassSettingName}")" OnClick="() => OpenEdit(setting)" />
                        @if (!setting.IsDefault)
                        {
                            <IconButton Icon="bi-trash" Title="@($"Delete {setting.ClassSettingName}")" OnClick="() => confirmDelete = setting" />
                        }
                    </td>
                </tr>
            }
        </Body>
    </DataTable>
}

@if (editing is not null)
{
    <Modal Title="@(isCreating ? "New Class Setting" : "Edit Class Setting")" Size="ModalSize.Wide" OnClose="CancelEdit">
        <ChildContent>
            <FormField For="cs-name" Label="Setting Name">
                <input id="cs-name" type="text" @bind="editing.Name" />
            </FormField>

            <div class="wec-form-field">
                <label>Classes</label>
                <div class="wec-class-list">
                    @for (var i = 0; i < editing.Items.Count; i++)
                    {
                        var index = i;
                        var item = editing.Items[index];
                        <div class="wec-class-list__row">
                            <div class="wec-class-list__field">
                                <label>Name</label>
                                <input type="text" @bind="item.Name" />
                            </div>
                            <div class="wec-class-list__field wec-class-list__field--color">
                                <label>Color</label>
                                <input type="color" @bind="item.Color" />
                            </div>
                            <div class="wec-class-list__actions">
                                <button type="button" class="wec-btn wec-btn--icon" title="Move up" disabled="@(index == 0)"
                                        @onclick="() => editing!.MoveUp(index)">
                                    <i class="bi bi-caret-up-fill"></i>
                                </button>
                                <button type="button" class="wec-btn wec-btn--icon" title="Move down"
                                        disabled="@(index == editing.Items.Count - 1)" @onclick="() => editing!.MoveDown(index)">
                                    <i class="bi bi-caret-down-fill"></i>
                                </button>
                                <button type="button" class="wec-btn wec-btn--icon" title="Remove"
                                        @onclick="() => editing!.RemoveItem(item)">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                        </div>
                    }
                    <button type="button" class="wec-modal__btn wec-modal__btn--secondary" @onclick="editing.AddItem">
                        <i class="bi bi-plus-lg"></i> Add Class
                    </button>
                </div>
            </div>

            <CheckboxField Id="cs-default" Label="Set as default" @bind-Value="editing.IsDefault"
                           Disabled="editingIsCurrentDefault" />
            @if (editingIsCurrentDefault)
            {
                <p class="wec-form-hint">This is the default class setting. Set another class setting as default to change this.</p>
            }
        </ChildContent>
        <Footer>
            <ModalActions ConfirmText="@(isCreating ? "Create" : "Save")" BusyText="Saving..." IsBusy="isSaving"
                          OnCancel="CancelEdit" OnConfirm="SaveAsync" />
        </Footer>
    </Modal>
}

@if (confirmDelete is not null)
{
    <ConfirmDialog Title="Delete Class Setting" CancelText="No" ConfirmText="Yes" IsBusy="isDeleting"
                   OnCancel="() => confirmDelete = null" OnConfirm="DeleteAsync">
        Delete @confirmDelete.ClassSettingName? This action cannot be undone.
    </ConfirmDialog>
}
