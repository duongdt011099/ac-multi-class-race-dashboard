@page "/gameconfig"
@rendermode InteractiveServer
@using MulticlassRace.ViewModels
@using multi_class_race_dashboard.Components.Shared
@inject MulticlassRace.Services.Abstractions.IAssettoCorsaGameConfigService ConfigService
@inject ToastService Toast

<PageTitle>Game Config</PageTitle>

<h1 class="nav-title">Game Config</h1>

<ToastHost />

<div class="wec-config">
    <div class="wec-config__intro">
        Configure the paths Assetto Corsa and Content Manager use for game files, presets, and race results.
    </div>

    <FolderPicker FieldLabel="Game Path" Title="Select Game Path" InputId="config-game-path"
                  Value="@config.GamePath" ValueChanged="SetGamePath" />
    <FolderPicker FieldLabel="Preset Path" Title="Select Preset Path" InputId="config-preset-path"
                  Value="@config.PresetPath" ValueChanged="SetPresetPath" />
    <FolderPicker FieldLabel="Race Results Path" Title="Select Race Results Path" InputId="config-results-path"
                  Value="@config.RaceResultsPath" ValueChanged="SetRaceResultsPath" />

    <div class="wec-config__actions">
        <button type="button" class="wec-modal__btn wec-modal__btn--primary" @onclick="SaveAsync" disabled="@isSaving">
            @(isSaving ? "Saving..." : "Save Configuration")
        </button>
    </div>
</div>

@code {
    private AssettoCorsaGameConfigModel config = new();
    private bool isSaving;

    protected override async Task OnInitializedAsync()
    {
        var existing = await ConfigService.GetAsync();
        if (existing is not null)
        {
            config = existing;
        }
    }

    private Task SetGamePath(string? value)
    {
        config.GamePath = value ?? string.Empty;
        return Task.CompletedTask;
    }

    private Task SetPresetPath(string? value)
    {
        config.PresetPath = value ?? string.Empty;
        return Task.CompletedTask;
    }

    private Task SetRaceResultsPath(string? value)
    {
        config.RaceResultsPath = value ?? string.Empty;
        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        if (isSaving)
        {
            return;
        }

        isSaving = true;

        try
        {
            var created = await ConfigService.SaveAsync(config);
            Toast.Show(created ? "Configuration created." : "Configuration saved.");
        }
        finally
        {
            isSaving = false;
        }
    }
}