@using MulticlassRace.Services.AssettoCorsa
@page "/gameconfig"
@rendermode Interactive
@inherits PageBase

<PageHeader Title="Game Config" />

<div class="wec-config">
    <div class="wec-config__intro">
        Where the dashboard finds Assetto Corsa and Content Manager. The game folder is asked for
        during installation, so there is normally nothing to do on this page.
    </div>

    <div class="wec-config__actions">
        <button type="button" class="wec-modal__btn wec-modal__btn--secondary" @onclick="ReadLocationAsync">Refresh</button>
    </div>

    <div class="wec-race-teams">
        <div class="wec-config__hint">
            <InfoRow Label="Assetto Corsa folder" Value="@(gameFolder ?? "Not found")" />
            <InfoRow Label="Found by" Value="@GameFolderSourceText" />
            <InfoRow Label="Content Manager"
                     Value="@(ContentManagerPaths.IsInstalled ? ContentManagerPaths.DataRoot : "Not installed")" />
        </div>
    </div>
</div>
