@page "/gameconfig"
@rendermode InteractiveServer
@using MulticlassRace.ViewModels
@using multi_class_race_dashboard.Components.Shared
@inject MulticlassRace.Services.Abstractions.IAssettoCorsaGameConfigService ConfigService
@inject MulticlassRace.Services.AssettoCorsaPathResolver PathResolver
@inject MulticlassRace.Services.GameConfigChangeNotifier ConfigNotifier
@inject ToastService Toast

<PageTitle>Game Config</PageTitle>

<h1 class="nav-title">Game Config</h1>

<ToastHost />

<div class="wec-config">
    <div class="wec-config__intro">
        Where the dashboard finds Assetto Corsa and Content Manager. The game folder is asked for
        during installation, so there is normally nothing to do on this page.
    </div>

    <div class="wec-config__actions">
        <button type="button" class="wec-modal__btn wec-modal__btn--secondary" @onclick="Refresh">Refresh</button>
    </div>

    <div class="wec-race-teams">
        <div class="wec-config__hint">
            <div class="wec-nav-human__row">
                <div class="wec-nav-human__info">
                    <span class="wec-nav-human__name">Assetto Corsa folder</span>
                    <span class="wec-nav-human__team">@(gameFolder ?? "Not found")</span>
                </div>
            </div>
            <div class="wec-nav-human__row">
                <div class="wec-nav-human__info">
                    <span class="wec-nav-human__name">Found by</span>
                    <span class="wec-nav-human__team">@GameFolderSourceText</span>
                </div>
            </div>
            <div class="wec-nav-human__row">
                <div class="wec-nav-human__info">
                    <span class="wec-nav-human__name">Content Manager</span>
                    <span class="wec-nav-human__team">@(ContentManagerPaths.IsInstalled ? ContentManagerPaths.DataRoot : "Not installed")</span>
                </div>
            </div>
        </div>

        @if (ContentManagerPaths.IsInstalled)
        {
            <div class="wec-config__hint">
                Grid presets are read from <code>@ContentManagerPaths.PresetsRoot</code> and session
                results from <code>@ContentManagerPaths.SessionsRoot</code>. Preset export and result
                import appear only when those folders exist.
            </div>
        }
    </div>

    <FolderPicker FieldLabel="Lua App Result Path" Title="Select Lua App Result Path" InputId="config-lua-results-path"
                  Value="@config.LuaResultPath" ValueChanged="SetLuaResultPath" />

    <div class="wec-config__hint">
        The Multiple Class Race Lua app writes finished session results here. The dashboard watches this
        folder and offers to import each result when Assetto Corsa closes. Results are split into
        <code>practice</code>, <code>qualifying</code> and <code>race</code> subfolders.
        Leave empty to use the default location: <code>@DefaultLuaResultPath</code>.
    </div>

    <div class="wec-config__actions">
        <button type="button" class="wec-modal__btn wec-modal__btn--primary" @onclick="SaveAsync" disabled="@isSaving">
            @(isSaving ? "Saving..." : "Save Configuration")
        </button>
    </div>
</div>

@code {
    private AssettoCorsaGameConfigModel config = new();
    private bool isSaving;
    private string? gameFolder;
    private AssettoCorsaPathSource source;

    private static string DefaultLuaResultPath => LuaResultPaths.DefaultRoot;

    private string GameFolderSourceText => source switch
    {
        AssettoCorsaPathSource.Installer => "The installer (install.json)",
        AssettoCorsaPathSource.Saved => "A previously saved configuration",
        AssettoCorsaPathSource.AutoDetected => "Automatic detection",
        _ => "Not found. Reinstall the dashboard and point it at the game folder."
    };

    protected override async Task OnInitializedAsync()
    {
        var existing = await ConfigService.GetAsync();

        if (existing is not null)
        {
            config = existing;
        }

        await ReadLocationAsync();
    }

    private async Task ReadLocationAsync()
    {
        var location = await PathResolver.GetAsync();
        gameFolder = location.Path;
        source = location.Source;
    }

    private async Task Refresh()
    {
        await ReadLocationAsync();
    }

    private Task SetLuaResultPath(string? value)
    {
        config.LuaResultPath = value ?? string.Empty;
        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        if (isSaving)
        {
            return;
        }

        isSaving = true;

        try
        {
            var created = await ConfigService.SaveAsync(config);
            ConfigNotifier.NotifyChanged();
            Toast.Show(created ? "Configuration created." : "Configuration saved.");
        }
        finally
        {
            isSaving = false;
        }
    }
}
