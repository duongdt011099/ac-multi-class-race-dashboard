@using MulticlassRace.ViewModels

<Modal Title="Standings" Size="ModalSize.Wider" OverlayClass="wec-modal-overlay--top" OnClose="OnClose">
    @if (Standings is null)
    {
        <div class="wec-empty wec-empty--block">Loading standings...</div>
    }
    else if (!Standings.Any())
    {
        <div class="wec-empty wec-empty--block">No driver standings recorded for this season.</div>
    }
    else
    {
        var filtered = StandingsFilter.ByClass(Standings, classFilter);

        <div class="wec-session-toolbar">
            <label for="standing-class-filter" class="wec-session-toolbar__label">Class</label>
            <AppSelect Id="standing-class-filter" CssClass="wec-result-file-select wec-session-toolbar__select"
                       @bind-Value="classFilter" EmptyLabel="All classes"
                       Options="@(StandingsFilter.ClassNames(Standings).Select(c => new SelectOption(c, c)))" />
        </div>

        <div class="wec-podium">
            @foreach (var slot in PodiumSlots)
            {
                var standing = filtered.Count > slot.Index ? filtered[slot.Index] : null;
                <div class="wec-podium__slot @slot.Style">
                    @if (standing is not null)
                    {
                        <div class="wec-podium__card wec-podium__card--@(slot.Style)">
                            <div class="wec-podium__pos">@slot.Position</div>
                            <div class="wec-podium__logo-wrap">
                                @if (!string.IsNullOrWhiteSpace(standing.TeamLogoUrl))
                                {
                                    <img src="@standing.TeamLogoUrl" alt="@standing.TeamName" class="wec-podium__logo" />
                                }
                                else
                                {
                                    <span class="wec-podium__logo wec-podium__logo--fallback">
                                        @standing.TeamName[..Math.Min(2, standing.TeamName.Length)].ToUpper()
                                    </span>
                                }
                            </div>
                            <div class="wec-podium__name">@standing.DriverName</div>
                            <div class="wec-podium__points">@standing.Points<span class="wec-podium__points-label"> pts</span></div>
                            <div>
                                <span class="wec-badge" style="background-color: @Colors.ColorFor(standing.DriverClass)">@standing.DriverClass</span>
                            </div>
                        </div>
                    }
                    <div class="wec-podium__step wec-podium__step--@(slot.Style)"></div>
                </div>
            }
        </div>

        @if (filtered.Count > 3)
        {
            <div class="wec-table-scroll">
                <table class="wec-table">
                    <thead>
                        <tr>
                            <th>Pos</th>
                            <th>Driver</th>
                            <th>Team</th>
                            <th>Class</th>
                            <th>Points</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 3; i < filtered.Count; i++)
                        {
                            var standing = filtered[i];
                            <tr>
                                <td class="wec-table__position">@(i + 1)</td>
                                <td>@standing.DriverName</td>
                                <td>@standing.TeamName</td>
                                <td><span class="wec-badge" style="background-color: @Colors.ColorFor(standing.DriverClass)">@standing.DriverClass</span></td>
                                <td>@standing.Points</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</Modal>

@code {
    private string classFilter = "";

    /// <summary>Podium order left to right: second, first, third.</summary>
    private static readonly (int Index, int Position, string Style)[] PodiumSlots =
    {
        (1, 2, "second"),
        (0, 1, "first"),
        (2, 3, "third")
    };

    /// <summary>Season standings, best first; null while they load.</summary>
    [Parameter] public IReadOnlyList<DriverStandingsModel>? Standings { get; set; }

    [Parameter] public ClassColorMap Colors { get; set; } = ClassColorMap.Empty;

    [Parameter] public EventCallback OnClose { get; set; }
}
