@using MulticlassRace.Models
@using MulticlassRace.ViewModels

<div class="wec-celebrate wec-viewer wec-viewer--diamond" role="dialog" aria-modal="true" aria-label="World champion" @onclick="OnClose">
    <ConfettiRain Palette="DiamondPalette" Count="160" />

    <div class="wec-celebrate__card wec-viewer__card" @onclick:stopPropagation="true">
        <button type="button" class="wec-modal__close wec-celebrate__close" aria-label="Close" @onclick="OnClose">
            <i class="bi bi-x-lg"></i>
        </button>

        <div class="wec-celebrate__kicker">@Completion.ChampionshipName · @Completion.SeasonName</div>
        <h2 class="wec-celebrate__title wec-viewer__title">Congrats, you are World Champion!</h2>
        <div class="wec-celebrate__subtitle">
            @Completion.DriverName · @Completion.ClassName · @Completion.HumanPoints pts
        </div>

        <div class="wec-viewer__hero">
            <div class="wec-viewer__cup wec-viewer__cup--hero"><TrophyCup Achievement="Trophy" /></div>
        </div>

        <div class="wec-podium">
            @foreach (var slot in PodiumSlots)
            {
                var row = Completion.Podium.Count > slot.Index ? Completion.Podium[slot.Index] : null;
                <div class="wec-podium__slot @slot.Style">
                    @if (row is not null)
                    {
                        <div class="wec-podium__card wec-podium__card--@(slot.Style) @(row.IsHuman ? "wec-podium__card--you" : "")">
                            <div class="wec-podium__pos">@slot.Position</div>
                            <div class="wec-podium__logo-wrap">
                                <span class="wec-podium__logo wec-podium__logo--fallback">
                                    @row.TeamName[..Math.Min(2, row.TeamName.Length)].ToUpper()
                                </span>
                            </div>
                            <div class="wec-podium__name">@row.DriverName</div>
                            <div class="wec-podium__points">@row.Points<span class="wec-podium__points-label"> pts</span></div>
                            <div>
                                <span class="wec-badge" style="background-color: @Colors.ColorFor(row.ClassName)">@row.ClassName</span>
                            </div>
                        </div>
                    }
                    <div class="wec-podium__step wec-podium__step--@(slot.Style)"></div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private static readonly string[] DiamondPalette = { "#74e0ff", "#ffffff", "#3d86ee", "#d2a8ff", "#a8f0ff", "#ffc83d" };

    /// <summary>Podium order left to right: second, first, third.</summary>
    private static readonly (int Index, int Position, string Style)[] PodiumSlots =
    {
        (1, 2, "second"),
        (0, 1, "first"),
        (2, 3, "third")
    };

    [Parameter, EditorRequired] public SeasonCompletion Completion { get; set; } = default!;

    [Parameter] public ClassColorMap Colors { get; set; } = ClassColorMap.Empty;

    [Parameter] public EventCallback OnClose { get; set; }

    private AchievementModel Trophy => new()
    {
        Type = AchievementType.SeasonChampion,
        DriverName = Completion.DriverName ?? string.Empty,
        ChampionshipName = Completion.ChampionshipName,
        SeasonName = Completion.SeasonName,
        ClassName = Completion.ClassName,
        Points = Completion.HumanPoints,
        Position = 1,
        EarnedAt = DateTime.Now
    };
}
