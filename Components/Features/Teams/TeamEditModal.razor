@using MulticlassRace.Services.Notifications
@using Microsoft.AspNetCore.Components.Forms
@using MulticlassRace.Services.Teams
@using MulticlassRace.ViewModels
@inject ITeamLogoStorage LogoStorage
@inject ToastService Toast

<Modal Title="@(IsCreating ? "New Team" : "Edit Team")" Size="ModalSize.Wide" ModalClass="wec-modal--team"
       BodyClass="wec-modal__body--two-col" OnClose="OnCancel">
    <ChildContent>
      <div class="wec-team-col">
        @if (!IsCreating)
        {
            <FormField For="team-id" Label="Team ID" CssClass="wec-form-field--readonly">
                <input id="team-id" type="text" value="@Team.TeamId" readonly />
            </FormField>
        }

        <FormField For="team-name" Label="Team Name">
            <input id="team-name" type="text" @bind="Team.TeamName" />
        </FormField>

        <div class="wec-form-field">
            <label for="team-logo-file">Team Logo</label>
            <div class="wec-form-field__upload">
                @if (!string.IsNullOrWhiteSpace(Team.TeamLogo))
                {
                    <img src="@Team.TeamLogo" alt="Team logo preview" class="wec-form-field__preview" />
                }
                <InputFile id="team-logo-file" OnChange="HandleLogoUpload" accept="image/*" />
                <button type="button" class="wec-modal__btn wec-modal__btn--secondary wec-logo-picker__toggle" @onclick="ToggleLibrary">
                    <i class="bi bi-images"></i> @(showLibrary ? "Hide" : "Choose uploaded")
                </button>
            </div>

            @if (showLibrary)
            {
                <div class="wec-logo-picker">
                    @if (library is null)
                    {
                        <div class="wec-logo-picker__empty">Loading logos...</div>
                    }
                    else if (library.Count == 0)
                    {
                        <div class="wec-logo-picker__empty">No logos uploaded yet.</div>
                    }
                    else
                    {
                        @foreach (var logo in library)
                        {
                            var url = logo;
                            <button type="button" title="Use this logo"
                                    class="wec-logo-picker__item @(IsCurrent(url) ? "wec-logo-picker__item--current" : null)"
                                    @onclick="() => UseLogo(url)">
                                <img src="@url" alt="Uploaded logo" loading="lazy" />
                            </button>
                        }
                    }
                </div>
            }
        </div>

      </div>
      <div class="wec-team-col">
        <div class="wec-form-field">
            <label for="team-class-search">Team Classes</label>
            @if (ClassOptions.Count == 0)
            {
                <p class="wec-form-hint">No class settings configured. Add one under Class Settings.</p>
            }
            else
            {
                <ClassTagPicker Id="team-class-search" Options="ClassOptions" SelectedIds="Team.ClassSettingItemIds" />
            }
        </div>

        <CheckboxField Id="team-active" Label="Is Active" @bind-Value="Team.IsActive" />

        <TeamDriverList Drivers="Drivers" />
      </div>
    </ChildContent>
    <Footer>
        <ModalActions ConfirmText="@(IsCreating ? "Create" : "Save")" BusyText="Saving..." IsBusy="IsSaving"
                      Disabled="@(Drivers is null)" OnCancel="OnCancel" OnConfirm="OnSave" />
    </Footer>
</Modal>

@code {
    [Parameter, EditorRequired] public TeamFormModel Team { get; set; } = default!;

    [Parameter] public bool IsCreating { get; set; }

    [Parameter] public bool IsSaving { get; set; }

    [Parameter] public List<DriverModel>? Drivers { get; set; }

    [Parameter] public IReadOnlyCollection<ClassItemOption> ClassOptions { get; set; } = Array.Empty<ClassItemOption>();

    [Parameter] public EventCallback OnSave { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }

    // The uploaded logos are shown straight away; the button only hides them.
    private bool showLibrary = true;
    private IReadOnlyList<string>? library;

    protected override async Task OnInitializedAsync()
    {
        library = await LogoStorage.ListUploadedAsync();
    }

    // The team's address carries a ?v= version the library entries do not have.
    private bool IsCurrent(string url) =>
        !string.IsNullOrWhiteSpace(Team.TeamLogo) &&
        string.Equals(url, Team.TeamLogo.Split('?')[0], StringComparison.OrdinalIgnoreCase);

    private async Task ToggleLibrary()
    {
        showLibrary = !showLibrary;

        if (showLibrary)
        {
            library = await LogoStorage.ListUploadedAsync();
        }
    }

    private async Task UseLogo(string url)
    {
        try
        {
            Team.TeamLogo = await LogoStorage.UseUploadedAsync(Team.TeamId, url);
            library = await LogoStorage.ListUploadedAsync();
        }
        catch (InvalidLogoException ex)
        {
            Toast.Show(ex.Message, isError: true);
        }
    }

    private async Task HandleLogoUpload(InputFileChangeEventArgs e)
    {
        if (e.File is null)
        {
            return;
        }

        var file = e.File;

        try
        {
            Team.TeamLogo = await LogoStorage.SaveAsync(
                Team.TeamId,
                file.Name,
                file.ContentType,
                file.Size,
                () => file.OpenReadStream(TeamLogoStorage.MaxLogoSizeBytes));

            if (showLibrary)
            {
                library = await LogoStorage.ListUploadedAsync();
            }
        }
        catch (InvalidLogoException ex)
        {
            Toast.Show(ex.Message, isError: true);
        }
    }
}
