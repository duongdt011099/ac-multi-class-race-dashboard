@using MulticlassRace.ViewModels

<Modal Title="@($"Batch Edit ({Count} selected)")" Size="ModalSize.Wide" OnClose="OnCancel">
    <ChildContent>
        <p>Chosen classes replace each selected team's current classes.</p>

        <div class="wec-form-field">
            <label for="batch-team-class">Team Classes</label>
            @if (ClassOptions.Count == 0)
            {
                <p class="wec-form-hint">No class settings configured. Add one under Class Settings.</p>
            }
            else
            {
                <ClassTagPicker Id="batch-team-class" Options="ClassOptions" SelectedIds="selectedIds" />
            }
        </div>
    </ChildContent>
    <Footer>
        <ModalActions ConfirmText="Save" BusyText="Saving..." IsBusy="IsSaving"
                      OnCancel="OnCancel" OnConfirm="Confirm" />
    </Footer>
</Modal>

@code {
    [Parameter] public int Count { get; set; }

    [Parameter] public bool IsSaving { get; set; }

    [Parameter] public IReadOnlyCollection<ClassItemOption> ClassOptions { get; set; } = Array.Empty<ClassItemOption>();

    [Parameter] public EventCallback<List<Guid>> OnSave { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }

    private readonly List<Guid> selectedIds = new();

    private Task Confirm() => OnSave.InvokeAsync(selectedIds.ToList());
}
